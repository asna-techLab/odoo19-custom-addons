<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_archive_expired_products" model="ir.cron">
        <field name="name">Product: Automatically Archive Expired Products</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">model.archive_expired_products()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=1, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active">True</field>
    </record>
</odoo>