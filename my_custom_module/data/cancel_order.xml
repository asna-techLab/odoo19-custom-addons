<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_auto_cancel_draft_orders" model="ir.cron">
        <field name="name">Sales: Auto-Cancel Draft Orders Older Than 10 Days</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_cancel_draft_orders()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=0, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active">True</field>
    </record>
</odoo>