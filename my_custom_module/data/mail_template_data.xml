<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_overdue_invoice" model="mail.template">
        <field name="name">Overdue Invoice Alert</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="subject">Alert: Invoice {{ object.name }} is Overdue</field>
        <field name="email_to">{{ object.invoice_user_id.email or 'manager@example.com' }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p>Hello,</p>
                <p>This is an automated alert. The following customer invoice is currently overdue:</p>
                <ul>
                    <li><strong>Invoice:</strong> <t t-out="object.name"/></li>
                    <li><strong>Customer:</strong> <t t-out="object.partner_id.name"/></li>
                    <li><strong>Due Date:</strong> <t t-out="object.invoice_date_due"/></li>
                    <li><strong>Amount Due:</strong> <t t-out="object.amount_residual"/></li>
                </ul>
                <p>Please take the necessary follow-up actions.</p>
            </div>
        </field>
    </record>
</odoo>