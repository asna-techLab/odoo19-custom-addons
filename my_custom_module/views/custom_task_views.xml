<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List (Tree) View -->
    <record id="view_custom_task_list" model="ir.ui.view">
        <field name="name">custom.task.list</field>
        <field name="model">custom.task</field>
        <field name="arch" type="xml">
            <list string="Tasks">
                <field name="name"/>
                <field name="priority"/>
                <field name="is_completed"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_custom_task_form" model="ir.ui.view">
        <field name="name">custom.task.form</field>
        <field name="model">custom.task</field>
        <field name="arch" type="xml">
            <form string="Task">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="is_completed"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_custom_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">custom.task</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- App Root Menu -->
    <menuitem id="menu_custom_task_root" name="Task Manager"/>

    <!-- Sub-menu linking to Action -->
    <menuitem id="menu_custom_task_list"
              name="All Tasks"
              parent="menu_custom_task_root"
              action="action_custom_task"/>
</odoo>